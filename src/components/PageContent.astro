---
import {posts, postLink, categories, truncate} from '../lib/content';
import PostSnippet from './PostSnippet.astro';
import SocialLinks from './SocialLinks.astro';
const {page} = Astro.props;
const mainCategories = ['entrepreneurship','onspeaking','howto','personal','design','development'];
---
{page.slug === 'index' ? <>
  <hr/>
  <div class="row">
    <div class="col-md-4">
      <h3 class="sm-header"><a href="/work/">Projects</a></h3>
      <a href="/work/"><img src="/static/images/blog/hwd-book.jpg" alt="Hello Web Design"/></a>
      <div class="index-contact"><h3 class="sm-header"><a href="/contact/">Contact Me</a></h3><SocialLinks email="tracy@hellowebbooks.com" rss={false}/></div>
    </div>
    <div class="col-md-8">
      <div class="recent-writing"><h3 class="sm-header"><a href="/articles/">Recent Writing</a></h3>
        <ul class="list-unstyled">{posts.filter(p=>p.featured === 'True').map(post => <li><h4><a href={postLink(post)}>{post.title}</a>{post.external && <> <i class="fa fa-external-link" style="color: #999; font-size: 1rem; padding-left: 5px;"></i></>}</h4><p>{truncate(post.excerpt,40)}</p></li>)}</ul>
      </div>
      <div class="recent-speaking"><h3 class="sm-header"><a href="/speaking/">Upcoming Speaking Engagements</a></h3><ul class="list-unstyled"><li><span class="date">5/8/20</span><h4>FemtoConf</h4><span class="location">Darmstadt, Germany</span></li></ul></div>
    </div>
  </div>
</> : page.slug === 'articles' ? <>
  <h3 class="sm-header">Most recent post</h3>
  <ul class="list-unstyled blog-list"><PostSnippet post={posts[0]} first/></ul>
  <hr/>
  {[0,3].map(start => <div class="row sub-categories">{mainCategories.slice(start,start+3).map(slug => {
    const [,label,category] = categories.find(c=>c[0]===slug)!;
    return <div class="col-lg-4 col-md-6"><h3 class="sm-header"><a href={`/${slug}/`}>{slug==='howto'?'Instructionals':label}</a></h3><ul class="list-unstyled">{posts.filter(p=>p.category.includes(category)).map(post=><li class="hidden"><a href={postLink(post)}>{post.title}</a>{post.external && <> <i class="fa fa-external-link" style="color: #999; font-size: 0.8rem; padding-left: 5px;"></i></>}</li>)}</ul></div>;
  })}</div>)}
  <hr/>
  <h3 class="sm-header">All posts</h3><ul class="list-unstyled blog-list">{posts.slice(1,20).map(post=><PostSnippet post={post}/>)}</ul>
</> : page.category ? <ul class="list-unstyled blog-list">{posts.filter(p=>p.category.includes(page.category)).map(post=><PostSnippet post={post}/>)}</ul> : <Fragment set:html={page.content}/>}
