---
import SocialLinks from '../components/SocialLinks.astro';
import {site, defaultDescription} from '../lib/content';
const {title='Tracy Osborn', description=defaultDescription, bodyId='', bodyClass='', width='col-lg-10 col-lg-offset-1', canonical=Astro.url.pathname, post, highlight=false, noindex=false, editorial=false, navigation=[['/#work','Current work'],['/articles/','Writing archive']]} = Astro.props;
const footerNavigation = [['about','About'],['articles','Writing'],['work','Work'],['uses','Uses'],['speaking','Speaking']];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <meta name="author" content="Tracy Osborn"/>
  {noindex && <meta name="robots" content="noindex, nofollow"/>}
  <title>{title}</title>
  <meta name="description" content={description}/>
  <link rel="shortcut icon" href="/static/images/favicon.ico"/>
  {[57,60,72,76,114,120,144,152,180].map(size => <link rel="apple-touch-icon" sizes={`${size}x${size}`} href={`/static/images/favicons/apple-icon-${size}x${size}.png`}/>)}
  {[32,96,16].map(size => <link rel="icon" type="image/png" sizes={`${size}x${size}`} href={`/static/images/favicons/favicon-${size}x${size}.png`}/>)}
  <link rel="icon" type="image/png" sizes="192x192" href="/static/images/favicons/android-icon-192x192.png"/>
  <link rel="canonical" href={new URL(canonical,site).href}/>
  <link rel="stylesheet" href="/static/scss/style.scss.css?v=11"/>
  <link rel="alternate" type="application/rss+xml" title="My Blog Feed" href="/rss.xml"/>
  <link href="https://fonts.googleapis.com/css?family=Lato:300,400,400i,700&display=swap" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css?family=Lora:400,400i,700,700i" rel="stylesheet"/>
  {post && <>
    <meta property="og:url" content={new URL(canonical,site).href}/>
    <meta property="og:title" content={post.title}/>
    <meta property="og:type" content="article"/>
    <meta property="og:description" content={description}/>
    <meta name="twitter:site" content="@tracymakes"/>
    <meta name="twitter:image" property="og:image" content={`${site}/static/${post.featuredimage ? post.featuredimage.replace(/^\//,'') : 'images/tracy-osborn_atom-images.jpg'}`}/>
    <meta name="twitter:card" content="summary"/>
  </>}
  {highlight && <link rel="stylesheet" href="/static/css/tomorrow.css"/>}
  {editorial && <><link rel="stylesheet" href="/static/home/fonts/display.css"/><link rel="stylesheet" href="/static/home/editorial.css"/></>}
  <slot name="head"/>
</head>
<body id={bodyId} class:list={[bodyClass,{"editorial-site":editorial}]}>
  <slot name="preview-bar"/>
  <div class="container text-center">
    <nav class="row" id="main-nav">
      <a href="/"><img src="/static/images/sigs.png" alt="Tracy Osborn" class="logo-sig"/></a>
      <ul class="list-inline list-unstyled">
        {navigation.map(([slug,label]) => {
          const href=slug.startsWith('/') ? slug : `/${slug}/`;
          const current=!href.includes('#') && Astro.url.pathname===href;
          return <li class:list={{active:current}}><a href={href} aria-current={current?'page':undefined}>{label}</a></li>;
        })}
      </ul>
    </nav>
  </div>
  <div class="container"><div class="row"><div class={width}>
    <slot name="intro"/>
    <div id="content"><slot/></div>
  </div></div></div>
  <slot name="footer">{editorial ? <footer class="editorial-footer"><a href="/#work">Current work</a><a href="/articles/">Writing archive</a><a href="mailto:tracy@limedaring.com">Email</a><a href="/rss.xml">RSS</a></footer> : <div id="footer" class="container text-center"><div class="row"><div class="col-md-8 col-md-offset-2">
    <hr/>
    <nav id="footer-nav"><ul class="list-inline list-unstyled">
      {footerNavigation.map(([slug,label]) => <li><a href={slug.startsWith('/') ? slug : `/${slug}/`}>{label}</a></li>)}
      <li><a href="https://www.patreon.com/tracyosborn">Patreon</a></li>
      <li><a href="/contact/">Contact</a></li>
    </ul></nav>
    <SocialLinks email="tracy@limedaring.com"/>
  </div></div></div>}</slot>
  {bodyId === 'articles' && <script is:inline>document.querySelectorAll('.sub-categories ul').forEach(list => list.firstElementChild?.classList.remove('hidden'));</script>}
  {bodyId === 'error' && <script is:inline>const label = document.getElementById('url'); if (label) label.textContent = window.location.pathname;</script>}
  {highlight && <><script is:inline src="/static/js/highlight.pack.js"></script><script is:inline>hljs.initHighlightingOnLoad();</script></>}
</body>
</html>
