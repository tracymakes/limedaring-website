---
import HomeMockup from '../components/HomeMockup.astro';
import WritingArchive from '../components/WritingArchive.astro';
import Base from '../layouts/Base.astro';
import LegacyIntro from '../components/LegacyIntro.astro';
import PageContent from '../components/PageContent.astro';
import {pages} from '../lib/content';
export function getStaticPaths() {
  return pages.map(page => ({params:{slug:page.slug==='index'?undefined:page.slug},props:{page}}));
}
const {page} = Astro.props;
const width = page.contentsize?.match(/class="(.*?)"/)?.[1];
---
{page.slug==='index' ? <HomeMockup variant="story" production/> : page.slug==='articles' || page.category ? <WritingArchive page={page}/> : <Base title={page.title} bodyId={page.slug==='error'?'error':page.bodyId} width={width}>
  <LegacyIntro slot="intro" page={page}/>
  <PageContent page={page}/>
</Base>}
